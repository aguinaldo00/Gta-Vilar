{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["src/**", "scripts/**", "tests/**", "tools/**", "*.ts", "*.json", "!src/world/data", "!**/*.osm"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off", "useTemplate": "off", "noParameterAssign": "off" },
      "complexity": { "noForEach": "off" },
      "suspicious": { "noAssignInExpressions": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
